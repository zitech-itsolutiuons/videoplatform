# MongoDB Atlas
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/videoplatform

# JWT secrets — use two DIFFERENT long random strings
JWT_SESSION_SECRET=replace-with-a-long-random-string
JWT_STREAM_SECRET=replace-with-a-DIFFERENT-long-random-string

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=video-platform

# Used only by scripts/convertAndUpload.js when auto-creating a Video row
UPLOAD_ADMIN_USER_ID=64f0c2a1b2c3d4e5f6a7b8c9
